name: Build Streamstiny TIPA
on:
  push:
    branches: [main]
    paths:
      - 'Streamstiny/**'
      - 'scripts/**'
      - 'project.yml'
      - 'dependencies.yml'
      - '.github/workflows/build.yml'
      - '.gitattributes'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: build-${{ github.ref }}
  cancel-in-progress: true
jobs:
  build:
    if: ${{ github.repository == '2872636/Streamstiny-Builds' && github.ref == 'refs/heads/main' }}
    runs-on: macos-15
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      - name: Cache validated package for this commit
        id: package
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
        with:
          path: build/Streamstiny.tipa
          key: tipa-arm64-macos15-xcode16.4-${{ github.sha }}
      - name: Select Xcode
        if: steps.package.outputs.cache-hit != 'true'
        run: sudo xcode-select -s /Applications/Xcode_16.4.app/Contents/Developer
      - name: Cache verified XcodeGen archive
        if: steps.package.outputs.cache-hit != 'true'
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
        with:
          path: ~/Library/Caches/Streamstiny/xcodegen.zip
          key: xcodegen-macos-2.44.1-a2e905fb68446e9b
      - name: Generate Xcode project
        if: steps.package.outputs.cache-hit != 'true'
        run: |
          ARCHIVE="$HOME/Library/Caches/Streamstiny/xcodegen.zip"
          mkdir -p "$(dirname "$ARCHIVE")"
          if [ ! -f "$ARCHIVE" ]; then
            curl --fail --location --retry 3 https://github.com/yonaskolb/XcodeGen/releases/download/2.44.1/xcodegen.zip -o "$ARCHIVE"
          fi
          echo 'a2e905fb68446e9bb4008cdfe2e13e3f176d0cbcca828b71770f8e53fca91b73  '"$ARCHIVE" | shasum -a 256 -c -
          unzip -q "$ARCHIVE" -d "$RUNNER_TEMP/xcodegen"
          "$RUNNER_TEMP/xcodegen/xcodegen/bin/xcodegen" generate
      - name: Cache pinned native playback packages
        id: packages
        if: steps.package.outputs.cache-hit != 'true'
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
        with:
          path: build/SourcePackages
          key: swiftpackages-macos15-xcode16.4-${{ hashFiles('dependencies.yml', 'scripts/patch_playback.py') }}
      - name: Cache compiled release products
        if: steps.package.outputs.cache-hit != 'true'
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
        with:
          path: |
            build/device/Build
            build/device/ModuleCache.noindex
            build/device/SDKStatCaches.noindex
            build/Package.resolved
          key: release-arm64-macos15-xcode16.4-${{ hashFiles('dependencies.yml', 'scripts/patch_playback.py') }}-${{ hashFiles('project.yml', 'Streamstiny/**') }}
          restore-keys: release-arm64-macos15-xcode16.4-${{ hashFiles('dependencies.yml', 'scripts/patch_playback.py') }}-
      - name: Build optimized ARM64 Release
        if: steps.package.outputs.cache-hit != 'true'
        run: |
          RESOLVED="Streamstiny.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
          if [ "${{ steps.packages.outputs.cache-hit }}" = "true" ] && [ -f build/Package.resolved ]; then
            mkdir -p "$(dirname "$RESOLVED")"
            cp build/Package.resolved "$RESOLVED"
          else
            xcodebuild -resolvePackageDependencies -project Streamstiny.xcodeproj -scheme Streamstiny -clonedSourcePackagesDirPath build/SourcePackages -skipPackageUpdates
            cp "$RESOLVED" build/Package.resolved
          fi
          python3 scripts/patch_playback.py
          xcodebuild build -project Streamstiny.xcodeproj -scheme Streamstiny -configuration Release -destination 'generic/platform=iOS' -clonedSourcePackagesDirPath build/SourcePackages -disableAutomaticPackageResolution -skipPackageUpdates -derivedDataPath build/device -jobs "$(sysctl -n hw.logicalcpu)" -parallelizeTargets ARCHS=arm64 CODE_SIGNING_ALLOWED=NO COMPILER_INDEX_STORE_ENABLE=NO
      - name: Package and validate TrollStore IPA
        if: steps.package.outputs.cache-hit != 'true'
        run: bash scripts/package.sh
      - name: Validate cached package
        if: steps.package.outputs.cache-hit == 'true'
        run: python3 scripts/validate_ipa.py build/Streamstiny.tipa
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: Streamstiny-TIPA
          path: build/Streamstiny.tipa
          if-no-files-found: error
          retention-days: 3
          compression-level: 0
